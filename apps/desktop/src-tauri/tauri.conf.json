{
  "$schema": "https://raw.githubusercontent.com/nickkuk/nickkuk.github.io/refs/heads/main/src/schemas/tauri-2.schema.json",
  "productName": "fpath",
  "version": "0.0.0",
  "identifier": "studio.blueforge.fpath",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "bundle": {
    "createUpdaterArtifacts": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "fpath",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      },
      {
        "label": "popup",
        "url": "index.html#popup",
        "title": "fpath quick search",
        "width": 640,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main",
          "description": "Capability for the main window — full IPC access including writes and external app launching.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "dialog:allow-open",
            "fs:default",
            "fs:allow-read-text-file",
            "fs:allow-read-dir",
            "fs:allow-exists",
            "fs:allow-watch",
            "store:default",
            "clipboard-manager:default",
            "clipboard-manager:allow-write-text"
          ]
        },
        {
          "identifier": "popup",
          "description": "Capability for the Mode B popup window — strictly read-only filesystem + tree browsing. No dialog, no external-app launching, no writes to the workspace.",
          "windows": ["popup"],
          "permissions": [
            "core:default",
            "core:event:default",
            "core:window:default",
            "core:webview:default",
            "core:path:default",
            "clipboard-manager:default",
            "clipboard-manager:allow-write-text"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/blueforge-studio/fpath/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxRjc2N0UwNjE3MTEyNjQKUldSa0VuRmg0R2YzSWZjVEEzMHhrOUxFY2NrY28zaUhZN1BWV3IwZVM0ZmNaZnFzRUl0VGZKN2gK"
    },
    "fs": { "scope": { "allow": ["**"] } },
    "dialog": { "all": true },
    "clipboard-manager": { "all": true },
    "global-shortcut": { "shortcuts": ["CmdOrCtrl+Shift+F"] }
  }
}
